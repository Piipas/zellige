# Copy to .env.local for local development. Never commit real values.

# GitHub token used to read public contribution calendars (GraphQL API).
# Create a *classic* token with NO scopes selected:
#   https://github.com/settings/tokens/new?description=zellige
# No scopes means it can only read public data, which is all this app needs.
GITHUB_TOKEN=

# Public URL of your deployment, used in README snippets and metadata,
# e.g. https://zellige.example.com. Optional on Vercel: it falls back to the
# project's production domain. Locally it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
